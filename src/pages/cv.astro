---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';

// Import YAML data using fs and js-yaml
import fs from 'node:fs';
import path from 'node:path';
import * as yaml from 'js-yaml';

const cvFilePath = path.join(process.cwd(), '_data', 'cv.yml');
const cvFile = fs.readFileSync(cvFilePath, 'utf8');
const cvData: any = yaml.load(cvFile);
---

<Layout title="Curriculum Vitae | Michele Tizzani">
  <Header />

  <main class="w-full max-w-5xl mx-auto px-4 sm:px-6 md:px-8 py-10 sm:py-16">
    {/* Print-only header: name + contact block for the PDF */}
    <div class="hidden print:block mb-6">
      <h1 class="text-3xl font-serif mb-1">Michele Tizzani, PhD</h1>
      <p class="text-sm">Computational Social Scientist — Network Science · Computational Epidemiology</p>
      <p class="text-sm">Copenhagen, Denmark · micti@dtu.dk · ORCID 0000-0003-3068-5111 · micheletizzani.github.io</p>
    </div>

    <div class="mb-16 print:hidden flex items-end justify-between gap-4 flex-wrap">
      <h1 class="text-5xl font-serif leading-tight border-b-2 border-[var(--border-color)] pb-4 inline-block">Curriculum Vitae</h1>
      <button
        id="print-cv"
        class="no-print mb-2 inline-flex items-center gap-2 px-4 py-2 border border-[var(--accent-color)] text-[var(--accent-color)] rounded hover:bg-[var(--accent-color)] hover:text-[var(--bg-color)] transition-colors text-sm font-medium"
        aria-label="Print or save this CV as PDF"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z" />
        </svg>
        Print / Save PDF
      </button>
    </div>

    <div class="space-y-16 print:space-y-6">
      {cvData.map((section: any) => (
        <section class="cv-print-section">
          <h2 class="text-2xl font-serif mb-6 border-b border-[var(--border-color)] pb-2 text-[var(--heading-color)]">
            {section.title}
          </h2>
          
          {section.type === 'map' && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {section.contents.map((item: any) => (
                <div>
                  <span class="font-semibold text-[var(--heading-color)]">{item.name}:</span> 
                  <span class="text-[var(--text-color)] opacity-90">{item.value}</span>
                </div>
              ))}
            </div>
          )}

          {section.type === 'time_table' && (
            <div class="space-y-8">
              {section.contents.map((item: any) => (
                <div class="flex flex-col md:flex-row md:space-x-8 group">
                  <div class="md:w-32 shrink-0">
                    <span class="text-sm font-mono tracking-wider opacity-70 group-hover:text-[var(--accent-color)] transition-colors">{item.year}</span>
                  </div>
                  <div>
                    <h3 class="text-lg font-medium text-[var(--heading-color)]">{item.title}</h3>
                    <p class="text-sm text-[var(--text-color)] opacity-80 mt-1 italic">{item.institution}</p>
                    {item.description && item.description.length > 0 && (
                      <ul class="list-disc list-outside ml-4 mt-3 space-y-1 text-sm text-[var(--text-color)] opacity-90">
                        {item.description.map((desc: string) => (
                          <li>{desc}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}

          {section.type === 'nested_list' && (
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
              {section.contents.map((item: any) => (
                <div>
                  <h3 class="font-medium text-[var(--heading-color)] mb-3">{item.title}</h3>
                  <ul class="list-disc list-inside space-y-1 text-sm text-[var(--text-color)] opacity-90">
                    {item.items.map((subitem: string) => (
                      <li>{subitem}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>
  </main>
</Layout>

<script>
  document.getElementById('print-cv')?.addEventListener('click', () => window.print());
</script>
