---
import ArtLayout from '../../layouts/ArtLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import * as yaml from 'js-yaml';

// Parse markdown files from _photography directory
const photographyDir = path.join(process.cwd(), '_photography');
let photos = [];

if (fs.existsSync(photographyDir)) {
  const files = fs.readdirSync(photographyDir).filter(f => f.endsWith('.md'));
  
  photos = files.map(filename => {
    const filePath = path.join(photographyDir, filename);
    const fileContent = fs.readFileSync(filePath, 'utf8');
    
    // Extract frontmatter manually
    const parts = fileContent.split('---');
    let data = {};
    if (parts.length >= 3) {
      try {
        data = yaml.load(parts[1].trim());
      } catch (e) {
        console.error('Error parsing yaml in', filename, e);
      }
    }
    
    return {
      ...data,
      slug: filename.replace('.md', ''),
    };
  });

  // Sort by date descending
  photos.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
}
---

<ArtLayout title="Photography | Art World" active="photography">
	<header class="mb-20 text-center">
		<h1 class="text-4xl md:text-6xl font-serif tracking-widest uppercase opacity-90 mb-4">Photography</h1>
		<p class="text-sm md:text-base tracking-[0.2em] uppercase text-white/50">Captured Moments & Environments</p>
	</header>

	<div class="columns-1 md:columns-2 lg:columns-3 gap-8 space-y-8">
		{photos.map((photo) => (
			<div class="relative group break-inside-avoid bg-white p-4 md:p-6 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)] rounded-sm overflow-hidden flex flex-col items-center">
				<img 
					src={photo.image} 
					alt={photo.title} 
					class="w-full h-auto max-h-[75vh] object-contain transform transition-transform duration-700 group-hover:scale-[1.02]"
					loading="lazy"
				/>
				
				{/* Clean minimal info section below the photo inside the frame */}
				<div class="w-full mt-4 flex flex-col items-start opacity-70 group-hover:opacity-100 transition-opacity duration-300">
					<h3 class="text-lg font-serif text-black mb-1">{photo.title}</h3>
					<div class="flex items-center gap-3 text-[10px] tracking-widest uppercase text-black/60">
						{photo.location && <span>{photo.location}</span>}
						{photo.date && <span>{new Date(photo.date).getFullYear()}</span>}
					</div>
					{photo.description && <p class="mt-2 text-xs text-black/80 font-light">{photo.description}</p>}
				</div>
			</div>
		))}
	</div>
</ArtLayout>
