---
import ArtLayout from '../../layouts/ArtLayout.astro';
---

<ArtLayout title="Writing | Art World" active="writing">
	<header class="mb-16 text-center">
		<h1 class="text-4xl md:text-6xl font-serif tracking-widest uppercase opacity-90 mb-4">Writing</h1>
		<p class="text-sm md:text-base tracking-[0.2em] uppercase text-white/50">Notes · Essays · Fragments</p>
	</header>

	<div class="max-w-2xl mx-auto text-center">
		<p class="text-white/60 font-light leading-relaxed">
			A page still being written. Essays and shorter fragments will appear here soon.
		</p>
		<a href="/art" class="mt-10 inline-block text-xs tracking-[0.25em] uppercase text-white/40 hover:text-white transition-colors">
			← Back to the gallery
		</a>
	</div>
</ArtLayout>
