---
import ArtLayout from '../../layouts/ArtLayout.astro';
import ArtisticCanvas from '../../components/art/ArtisticCanvas.tsx';
---

<ArtLayout title="Digital Art | Art World" active="digital">
	{/* Full-viewport generative canvas behind the content */}
	<div class="fixed inset-0 z-0">
		<ArtisticCanvas client:only="react" />
	</div>

	<div class="relative z-10 min-h-[60vh] flex flex-col items-center justify-center text-center pointer-events-none">
		<h1 class="text-4xl md:text-6xl font-serif tracking-widest uppercase opacity-90 mb-4">Digital Art</h1>
		<p class="text-sm md:text-base tracking-[0.2em] uppercase text-white/50 max-w-md">
			Generative, code-driven experiments — a living particle field in perpetual motion.
		</p>
	</div>

    <div class="relative z-10 container mx-auto px-6 pb-20">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <a href="/art/echo-battleground" class="group block border border-white/10 hover:border-white/30 transition-colors bg-black/40 backdrop-blur-sm overflow-hidden pointer-events-auto">
                <div class="p-6">
                    <h2 class="text-xl font-serif tracking-widest uppercase mb-2 group-hover:text-[#4A7BB7] transition-colors">Echo / Battleground</h2>
                    <p class="text-xs tracking-wider text-white/40 uppercase mb-4">Interactive WebGL & Web Audio</p>
                    <p class="text-sm text-white/60 line-clamp-3">
                        A model-bound digital art piece rendering real annotation data. Explore the continuous stance and sentiment axes of YouTube comments through an immersive audio-visual particle field.
                    </p>
                </div>
            </a>
            <a href="/ar/" class="group block border border-white/10 hover:border-[#FF5B04]/60 transition-colors bg-black/40 backdrop-blur-sm overflow-hidden pointer-events-auto">
                <div class="p-6">
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-xl font-serif tracking-widest uppercase group-hover:text-[#FF5B04] transition-colors">Echo / Battleground AR</h2>
                        <span class="text-[9px] font-mono uppercase px-2 py-0.5 rounded bg-[#FF5B04]/20 text-[#FF5B04] border border-[#FF5B04]/30">Poster WebAR</span>
                    </div>
                    <p class="text-xs tracking-wider text-white/40 uppercase mb-4">Spatial Computer Vision & Three.js</p>
                    <p class="text-sm text-white/60 line-clamp-3">
                        Augmented reality companion for the CS2Nordics poster. Point your mobile camera at the physical poster header to unlock dynamic particle flows, homophilic loops, and longitudinal P90 saturation curves.
                    </p>
                </div>
            </a>

        </div>
    </div>
</ArtLayout>
