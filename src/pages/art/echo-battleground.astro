---
import PieceCanvas from '../../pieces/echo-battleground/PieceCanvas.tsx';
import '../../styles/global.css';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/assets/img/icon.jpg" />
    <title>Echo / Battleground - Digital Art</title>
  </head>
  <body class="bg-black text-white w-full h-screen overflow-hidden m-0 p-0 font-sans antialiased">
    <!-- Back to surface / publications -->
    <a 
      href="/publications" 
      class="absolute top-8 right-8 z-50 text-[11px] uppercase tracking-[0.2em] text-white/40 hover:text-white transition-colors"
    >
      Close Piece ✕
    </a>

    <!-- Navigation Hint -->
    <div class="absolute bottom-8 left-[340px] right-0 z-50 flex justify-center pointer-events-none">
      <div class="flex flex-col items-center gap-3 text-white/40" style="animation: pulseHint 4s ease-in-out infinite;">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
          <path d="M3 3v5h5" />
        </svg>
        <span class="text-[10px] uppercase tracking-[0.3em]">Drag to explore</span>
      </div>
    </div>
    
    <style>
      @keyframes pulseHint {
        0%, 100% { opacity: 0.2; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.05); }
      }
    </style>

    <PieceCanvas client:only="react" />
  </body>
</html>
