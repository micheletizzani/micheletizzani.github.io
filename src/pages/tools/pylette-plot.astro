---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/layout/Header.astro";
import PyletteInteractive from "../../components/tools/PyletteInteractive";

const tool = {
  name: "Pylette Plot",
  tagline: "Dominant colour palette extraction & publication-ready visualisation for Python.",
  github: "https://github.com/mictiz/pylette_plot",
  tags: ["Python", "Colour Science", "Visualisation", "Open Source"],
  description: [
    "Pylette Plot is a lightweight Python library that extracts the dominant colour palette from any image using k-means clustering and renders the result as a clean, publication-ready figure.",
    "It is designed for researchers and designers who need reproducible, aesthetic colour summaries — for figures in papers, design presentations, or exploratory data analysis. The output is a Matplotlib figure you can embed directly into any workflow.",
  ],
  features: [
    { id: "01", title: "Palette Extraction", body: "K-means clustering on RGB pixel space with configurable number of colours." },
    { id: "02", title: "Publication Figures", body: "Clean Matplotlib output, tight-layout ready, exportable to PNG, SVG, or PDF." },
    { id: "03", title: "Zero Boilerplate", body: "One function call — pass an image path, get a publication-ready figure." },
    { id: "04", title: "Composable", body: "Returns raw palette arrays for integration into custom visualization pipelines." },
  ],
  install: "pip install pylette-plot",
  usage: `from pylette_plot import plot_palette

# Extract 6 dominant colours and show the palette
fig = plot_palette("path/to/your/image.jpg", n_colors=6)
fig.savefig("palette.png", dpi=150, bbox_inches="tight")`,
};
---

<Layout title={`${tool.name} | Tools | Michele Tizzani`}>
  <Header />

  <main class="max-w-7xl mx-auto px-6 md:px-12 pb-24 pt-10">
    {/* Top navigation with Return to Main Page */}
    <nav class="flex items-center justify-between mb-10 pb-4 border-b border-[var(--border-color)]">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs font-semibold tracking-[0.2em] uppercase text-[var(--text-color)] opacity-70 hover:opacity-100 hover:text-[var(--accent-color)] transition-all"
      >
        ← Return to Main Page
      </a>
      <div class="flex items-center gap-3 text-xs tracking-[0.2em] uppercase text-[var(--text-color)] opacity-50">
        <a href="/tools" class="hover:text-[var(--accent-color)] hover:opacity-100 transition-colors">Tools</a>
        <span>/</span>
        <span class="opacity-90">{tool.name}</span>
      </div>
    </nav>

    {/* Title block */}
    <div class="mb-12 border-b border-[var(--border-color)] pb-10">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div>
          <h1 class="text-4xl md:text-5xl font-serif text-[var(--heading-color)] leading-tight mb-3">
            {tool.name}
          </h1>
          <p class="text-base text-[var(--text-color)] opacity-75 leading-relaxed max-w-xl">
            {tool.tagline}
          </p>
        </div>
        <a
          href={tool.github}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 border border-[var(--accent-color)] text-[var(--accent-color)] rounded hover:bg-[var(--accent-color)] hover:text-[var(--bg-color)] transition-colors text-xs font-semibold uppercase tracking-wider"
        >
          View on GitHub →
        </a>
      </div>

      {/* Tags */}
      <div class="flex flex-wrap gap-2 mt-6">
        {
          tool.tags.map((tag) => (
            <span class="text-[10px] tracking-[0.15em] uppercase px-3 py-1 border border-[var(--border-color)] text-[var(--text-color)] opacity-60 rounded-sm">
              {tag}
            </span>
          ))
        }
      </div>
    </div>

    {/* Interactive Minimal Application */}
    <PyletteInteractive client:load />

    {/* About section */}
    <section class="mb-14 prose dark:prose-invert max-w-none text-[var(--text-color)] opacity-90 leading-relaxed">
      <h2 class="text-2xl font-serif mb-5 text-[var(--heading-color)] flex items-center">
        <span class="mr-4">About</span>
        <div class="flex-grow h-px bg-[var(--border-color)]"></div>
      </h2>
      {tool.description.map((para) => <p class="mb-4 text-justify">{para}</p>)}
    </section>

    {/* Features grid (no icons/emojis, clean numbers) */}
    <section class="mb-14">
      <h2 class="text-2xl font-serif mb-8 text-[var(--heading-color)] flex items-center">
        <span class="mr-4">Features</span>
        <div class="flex-grow h-px bg-[var(--border-color)]"></div>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-[var(--border-color)] border border-[var(--border-color)]">
        {
          tool.features.map((f) => (
            <div class="bg-[var(--bg-color)] p-8 hover:bg-[var(--bg-secondary)] transition-colors">
              <span class="text-xs font-mono text-[var(--accent-color)] font-semibold block mb-2">{f.id}</span>
              <h3 class="text-sm font-semibold tracking-wide uppercase text-[var(--heading-color)] mb-2">{f.title}</h3>
              <p class="text-sm text-[var(--text-color)] opacity-65 leading-relaxed">{f.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* Install + Usage */}
    <section class="mb-14">
      <h2 class="text-2xl font-serif mb-8 text-[var(--heading-color)] flex items-center">
        <span class="mr-4">Quick Start</span>
        <div class="flex-grow h-px bg-[var(--border-color)]"></div>
      </h2>

      <p class="text-xs tracking-[0.2em] uppercase text-[var(--text-color)] opacity-50 mb-3">Install</p>
      <pre
        class="bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded p-5 text-sm font-mono text-[var(--text-color)] overflow-x-auto mb-8"><code>{tool.install}</code></pre>

      <p class="text-xs tracking-[0.2em] uppercase text-[var(--text-color)] opacity-50 mb-3">Usage</p>
      <pre
        class="bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded p-5 text-sm font-mono text-[var(--text-color)] overflow-x-auto leading-relaxed"><code>{tool.usage}</code></pre>
    </section>

    {/* Footer back link */}
    <div class="pt-6 border-t border-[var(--border-color)] flex items-center justify-between">
      <a
        href="/"
        class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--text-color)] opacity-70 hover:opacity-100 hover:text-[var(--accent-color)] transition-colors"
      >
        ← Return to Main Page
      </a>
      <a
        href="/tools"
        class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--text-color)] opacity-50 hover:opacity-100 hover:text-[var(--accent-color)] transition-colors"
      >
        Back to Tools Index
      </a>
    </div>
  </main>
</Layout>
