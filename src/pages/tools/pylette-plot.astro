---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import PyletteApp from '../../components/tools/pylette/PyletteApp';

const tool = {
	name: 'Pylette Plot',
	tagline: 'Dominant colour palette extraction & publication-ready visualisation for Python.',
	github: 'https://github.com/mictiz/pylette_plot',
	tags: ['Python', 'Colour Science', 'Visualisation', 'Open Source'],
	description: [
		'Pylette Plot is a lightweight Python library that extracts the dominant colour palette from any image using k-means clustering and renders the result as a clean, publication-ready figure.',
		'It is designed for researchers and designers who need reproducible, aesthetic colour summaries — for figures in papers, design presentations, or exploratory data analysis. The output is a Matplotlib figure you can embed directly into any workflow.',
	],
	features: [
		{ icon: '🎨', title: 'Palette extraction', body: 'K-means clustering on RGB pixel space; configurable number of colours (default: 6).' },
		{ icon: '📐', title: 'Publication figures', body: 'Clean Matplotlib output, tight-layout ready, export to any format (PNG, SVG, PDF).' },
		{ icon: '⚡', title: 'Zero boilerplate', body: 'One function call — pass an image path, get a figure back.' },
		{ icon: '🔧', title: 'Composable', body: 'Returns raw palette arrays so you can pipe the colours into your own visualisation.' },
	],
	install: 'pip install pylette-plot',
	usage: `from pylette_plot import plot_palette

# Extract 6 dominant colours and show the palette
fig = plot_palette("path/to/your/image.jpg", n_colors=6)
fig.savefig("palette.png", dpi=150, bbox_inches="tight")`,
};
---

<Layout title={`${tool.name} | Tools | Michele Tizzani`}>
	<Header />

	<main class="max-w-7xl mx-auto px-6 md:px-12 pb-24 pt-12">
		{/* Breadcrumb */}
		<nav class="mb-10 text-xs tracking-[0.2em] uppercase text-[var(--text-color)] opacity-50 flex items-center gap-2">
			<a href="/tools" class="hover:text-[var(--accent-color)] hover:opacity-100 transition-colors">Tools</a>
			<span>›</span>
			<span class="opacity-80">{tool.name}</span>
		</nav>

		{/* Title block */}
		<div class="mb-12 border-b border-[var(--border-color)] pb-10">
			<div class="flex flex-wrap items-start justify-between gap-6">
				<div>
					<h1 class="text-4xl md:text-5xl font-serif text-[var(--heading-color)] leading-tight mb-3">
						{tool.name}
					</h1>
					<p class="text-base text-[var(--text-color)] opacity-70 leading-relaxed max-w-lg">
						{tool.tagline}
					</p>
				</div>
				<a
					href={tool.github}
					target="_blank"
					rel="noopener noreferrer"
					class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 border border-[var(--accent-color)] text-[var(--accent-color)] rounded hover:bg-[var(--accent-color)] hover:text-[var(--bg-color)] transition-colors text-sm font-medium tracking-wide"
				>
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943" />
					</svg>
					View on GitHub
				</a>
			</div>

			{/* Tags */}
			<div class="flex flex-wrap gap-2 mt-6">
				{tool.tags.map((tag) => (
					<span class="text-[10px] tracking-[0.15em] uppercase px-3 py-1 border border-[var(--border-color)] text-[var(--text-color)] opacity-60 rounded-sm">
						{tag}
					</span>
				))}
			</div>
		</div>

		{/* Full Interactive Application */}
		<div class="mb-16 border border-[var(--border-color)] rounded-xl overflow-hidden shadow-lg bg-[var(--bg-color)]">
			<PyletteApp client:load />
		</div>

		{/* Description */}
		<section class="mb-14 prose dark:prose-invert max-w-none text-[var(--text-color)] opacity-90 leading-relaxed">
			<h2 class="text-2xl font-serif mb-5 text-[var(--heading-color)] flex items-center">
				<span class="mr-4">About</span>
				<div class="flex-grow h-px bg-[var(--border-color)]"></div>
			</h2>
			{tool.description.map((para) => (
				<p class="mb-4 text-justify">{para}</p>
			))}
		</section>

		{/* Features grid */}
		<section class="mb-14">
			<h2 class="text-2xl font-serif mb-8 text-[var(--heading-color)] flex items-center">
				<span class="mr-4">Features</span>
				<div class="flex-grow h-px bg-[var(--border-color)]"></div>
			</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-[var(--border-color)] border border-[var(--border-color)]">
				{tool.features.map((f) => (
					<div class="bg-[var(--bg-color)] p-8 hover:bg-[var(--bg-secondary)] transition-colors">
						<span class="text-2xl block mb-3">{f.icon}</span>
						<h3 class="text-sm font-semibold tracking-wide uppercase text-[var(--heading-color)] mb-2">{f.title}</h3>
						<p class="text-sm text-[var(--text-color)] opacity-65 leading-relaxed">{f.body}</p>
					</div>
				))}
			</div>
		</section>

		{/* Install + Usage */}
		<section class="mb-14">
			<h2 class="text-2xl font-serif mb-8 text-[var(--heading-color)] flex items-center">
				<span class="mr-4">Quick Start</span>
				<div class="flex-grow h-px bg-[var(--border-color)]"></div>
			</h2>

			<p class="text-xs tracking-[0.2em] uppercase text-[var(--text-color)] opacity-50 mb-3">Install</p>
			<pre class="bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded p-5 text-sm font-mono text-[var(--text-color)] overflow-x-auto mb-8"><code>{tool.install}</code></pre>

			<p class="text-xs tracking-[0.2em] uppercase text-[var(--text-color)] opacity-50 mb-3">Usage</p>
			<pre class="bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded p-5 text-sm font-mono text-[var(--text-color)] overflow-x-auto leading-relaxed"><code>{tool.usage}</code></pre>
		</section>

		{/* Footer back link */}
		<div class="pt-4 border-t border-[var(--border-color)]">
			<a href="/tools" class="text-sm font-medium hover:text-[var(--accent-color)] transition-colors">
				← Back to Tools
			</a>
		</div>
	</main>
</Layout>
