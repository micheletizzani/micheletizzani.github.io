---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';

// Import YAML data using fs and js-yaml
import fs from 'node:fs';
import path from 'node:path';
import * as yaml from 'js-yaml';

const papersFilePath = path.join(process.cwd(), '_data', 'all_papers.yml');
const papersFile = fs.readFileSync(papersFilePath, 'utf8');
const allPapers: any = yaml.load(papersFile);

// Group papers by year
const papersByYear = allPapers.reduce((acc: any, paper: any) => {
  const year = paper.year || 'Unknown';
  if (!acc[year]) acc[year] = [];
  acc[year].push(paper);
  return acc;
}, {});

// Sort years descending
const sortedYears = Object.keys(papersByYear).sort((a, b) => b.localeCompare(a));
---

<Layout title="Publications | Michele Tizzani">
  <Header />

  <main class="w-full max-w-5xl mx-auto px-4 sm:px-6 md:px-8 py-10 sm:py-16">
    <div class="mb-16">
      <h1 class="text-5xl font-serif mb-6 leading-tight border-b-2 border-[var(--border-color)] pb-4 inline-block">Publications</h1>
      <p class="text-[var(--text-color)] opacity-80 text-lg">A complete list of published research and preprints.</p>
    </div>

    <div class="space-y-16">
      {sortedYears.map((year: string) => (
        <section>
          <h2 class="text-3xl font-serif mb-8 text-[var(--heading-color)] flex items-center">
            <span class="mr-4">{year}</span>
            <div class="flex-grow h-px bg-[var(--border-color)]"></div>
          </h2>
          
          <ul class="space-y-10">
            {papersByYear[year].map((paper: any) => (
              <li class="group">
                <h3 class="text-xl font-medium text-[var(--heading-color)] group-hover:text-[var(--accent-color)] transition-colors leading-snug">
                  {paper.url ? (
                    <a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title}</a>
                  ) : (
                    paper.title
                  )}
                </h3>
                <p class="text-sm text-[var(--text-color)] opacity-90 mt-2 font-medium">
                  {paper.author}
                </p>
                <div class="text-sm text-[var(--text-color)] opacity-75 mt-1 italic">
                  {paper.journal} {paper.volume && <span>, Vol. {paper.volume}</span>} {paper.pages && <span>, pp. {paper.pages}</span>}
                </div>
                {paper.doi && (
                  <div class="mt-2">
                    <a href={`https://doi.org/${paper.doi}`} target="_blank" rel="noopener noreferrer" class="text-xs font-mono bg-[var(--bg-secondary)] px-2 py-1 rounded text-[var(--text-color)] hover:text-[var(--accent-color)] transition-colors">
                      DOI: {paper.doi}
                    </a>
                  </div>
                )}
                <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
                  {paper.abstract && (
                    <details class="text-sm text-[var(--text-color)] opacity-80 cursor-pointer">
                      <summary class="font-medium hover:text-[var(--accent-color)] transition-colors">Abstract</summary>
                      <p class="mt-2 pl-4 border-l-2 border-[var(--border-color)] leading-relaxed">{paper.abstract}</p>
                    </details>
                  )}
                  {paper.pages === 'e88519' && (
                    <a
                      href="/art/echo-battleground"
                      class="art-portal-link inline-flex items-center text-sm font-medium"
                      aria-label="State of the art: explore the paper as an interactive artwork"
                    >
                      State of the art: explore the paper →
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</Layout>
