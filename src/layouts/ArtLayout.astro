---
import '../styles/global.css';

interface Props {
	title: string;
	active?: string; // which section is current: photography | digital | music | writing
	maxW?: string;   // width class for the main container (default matches gallery)
}

const { title, active, maxW = 'max-w-[1400px]' } = Astro.props;

const sections = [
	{ name: 'Photography', href: '/art/photography', key: 'photography' },
	{ name: 'Digital', href: '/art/digital', key: 'digital' },
	{ name: 'Music', href: '/art/music', key: 'music' },
	{ name: 'Writing', href: '/art/writing', key: 'writing' },
];
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/jpeg" href="/assets/img/icon.jpg" />
		<title>{title}</title>
	</head>
	<body class="bg-black text-white min-h-screen font-sans antialiased selection:bg-white selection:text-black">

		<nav class="fixed top-0 w-full z-50 flex items-center justify-between gap-4 px-6 md:px-8 py-6 mix-blend-difference">
			<a href="/" class="flex items-center gap-3 group transition-opacity hover:opacity-80 shrink-0">
				<img src="/assets/img/icon.jpg" alt="Icon" class="w-9 h-9 rounded-full object-cover border border-white/20" />
				<span class="hidden sm:inline text-[11px] tracking-[0.2em] uppercase opacity-0 group-hover:opacity-100 transition-opacity duration-500">Back to Surface</span>
			</a>

			<div class="flex items-center gap-4 md:gap-7 text-[11px] md:text-xs tracking-[0.2em] uppercase">
				{sections.map((s) => (
					<a
						href={s.href}
						class:list={[
							'transition-opacity hover:opacity-100',
							active === s.key ? 'opacity-100 border-b border-white/70 pb-0.5' : 'opacity-50',
						]}
					>
						{s.name}
					</a>
				))}
			</div>
		</nav>

		<main class:list={['relative z-10 pt-32 pb-16 px-4 md:px-8 mx-auto', maxW]}>
			<slot />
		</main>

	</body>
</html>
