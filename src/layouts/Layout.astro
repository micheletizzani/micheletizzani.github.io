---
import '../styles/global.css';
import ArtisticCanvasWrapper from '../components/art/ArtisticCanvasWrapper';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Academic Portfolio and Digital Garden" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/jpeg" href="/assets/img/icon.jpg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Preload fonts for the high-end academic feel -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

		<!-- KaTeX CSS for rendering math -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" integrity="sha384-GvrOXuhMATgEsSwCs4smul74iXGOixntILdUW9XmUC6+HX0sLNAK3q71b053+089" crossorigin="anonymous">

		<script is:inline>
			// Check local storage for theme preference, default to light
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="antialiased min-h-screen flex flex-col relative overflow-x-hidden">
		<div id="professional-plane" class="flex-grow z-10 transition-opacity duration-700">
			<slot />
		</div>

		<!-- Artistic plane container (Z-Axis) -->
		<div id="artistic-canvas-container" class="fixed inset-0 z-50 pointer-events-none opacity-0 bg-[var(--bg-color)]">
			<button id="exit-art-mode" class="absolute top-6 left-6 text-[var(--text-color)] text-sm font-semibold tracking-wider hover:text-[var(--accent-color)] transition-colors z-50 opacity-0 pointer-events-none uppercase">
				← Return to Surface
			</button>

			<div class="absolute inset-0 z-0" id="canvas-wrapper">
				<!-- The canvas will be mounted here using Astro Islands architecture -->
			</div>

			<!-- Art Gallery Overlay Content -->
			<div class="relative z-10 w-full h-full flex flex-col items-center justify-center pointer-events-none opacity-0 transition-opacity duration-1000 delay-500" id="art-content-overlay">
				<h1 class="text-6xl font-serif text-[var(--heading-color)] mb-4 tracking-wider">The Gallery</h1>
				<p class="text-[var(--text-color)] opacity-70 tracking-widest uppercase text-sm mb-12">Photography · Digital · Music · Writing</p>

				<div class="pointer-events-auto flex flex-wrap justify-center gap-4 max-w-xl">
					<a href="/art/photography" class="px-6 py-4 border border-[var(--border-color)] hover:border-[var(--accent-color)] text-[var(--text-color)] hover:text-[var(--accent-color)] transition-colors bg-[var(--bg-color)]/50 backdrop-blur-sm">Photography</a>
					<a href="/art/digital" class="px-6 py-4 border border-[var(--border-color)] hover:border-[var(--accent-color)] text-[var(--text-color)] hover:text-[var(--accent-color)] transition-colors bg-[var(--bg-color)]/50 backdrop-blur-sm">Digital Art</a>
					<a href="/art/music" class="px-6 py-4 border border-[var(--border-color)] hover:border-[var(--accent-color)] text-[var(--text-color)] hover:text-[var(--accent-color)] transition-colors bg-[var(--bg-color)]/50 backdrop-blur-sm">Music</a>
					<a href="/art/writing" class="px-6 py-4 border border-[var(--border-color)] hover:border-[var(--accent-color)] text-[var(--text-color)] hover:text-[var(--accent-color)] transition-colors bg-[var(--bg-color)]/50 backdrop-blur-sm">Writing</a>
					<a href="/art" class="px-6 py-4 text-[var(--text-color)] opacity-70 hover:opacity-100 hover:text-[var(--accent-color)] transition-colors underline underline-offset-4">Gallery index</a>
				</div>
			</div>
		</div>

		<!-- Keyhole Transition Layer -->
		<div id="keyhole-transition-mask" class="pointer-events-none fixed inset-0 z-40 bg-black opacity-0" style="clip-path: path('M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z'); transform-origin: top right; transform: scale(0.01); transition: transform 1.5s cubic-bezier(0.76, 0, 0.24, 1), opacity 1.5s cubic-bezier(0.76, 0, 0.24, 1);"></div>

		<script>
			import { isArtMode } from '../store/modeStore';

			const exitBtn = document.getElementById('exit-art-mode');
			const profPlane = document.getElementById('professional-plane');
			const artContent = document.getElementById('art-content-overlay');
			const artContainer = document.getElementById('artistic-canvas-container');
			const keyholeMask = document.getElementById('keyhole-transition-mask');

			if (exitBtn && profPlane && artContent && artContainer && keyholeMask) {
				exitBtn.addEventListener('click', () => {
					isArtMode.set(false);
					
					// Revert DOM
					profPlane.style.opacity = '1';
					profPlane.style.pointerEvents = 'auto';
					
					artContent.style.opacity = '0';
					exitBtn.style.opacity = '0';
					exitBtn.style.pointerEvents = 'none';
					
					keyholeMask.style.transform = 'scale(0.01)';
					keyholeMask.style.opacity = '0';

					setTimeout(() => {
						artContainer.classList.remove('active');
					}, 300);
				});

				// We also need to listen to isArtMode changes to update exitBtn visibility in case someone else triggers it
				isArtMode.subscribe((active) => {
					if (!active) {
						// Ensure it's hidden if deactivated elsewhere
						profPlane.style.opacity = '1';
						profPlane.style.pointerEvents = 'auto';
						
						artContent.style.opacity = '0';
						exitBtn.style.opacity = '0';
						exitBtn.style.pointerEvents = 'none';
						
						keyholeMask.style.transform = 'scale(0.01)';
						keyholeMask.style.opacity = '0';

						setTimeout(() => {
							artContainer.classList.remove('active');
						}, 300);
					} else {
					    // Activate transition
					    keyholeMask.style.transform = 'scale(100)';
					    keyholeMask.style.opacity = '1';
					}
				});
			}
		</script>
	</body>
</html>
